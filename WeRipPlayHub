-- Настройки по умолчанию
local espPlayersEnabled = true
local espBoxesEnabled = true
local autoLootEnabled = false
local antiAFKEnabled = false

-- Цвета
local TEAM_COLOR = Color3.fromRGB(0, 255, 0)    -- зеленый для тиммейтов
local ENEMY_COLOR = Color3.fromRGB(255, 0, 0)   -- красный для врагов
local CHEST_COLOR = Color3.fromRGB(0, 162, 255) -- синий для интерактивных сундуков

-- Кэши для подсветок, чтобы не пересоздавать их каждый цикл
local playerHighlights = {}
local chestHighlights = {}

-- Параметры оптимизации
local CHEST_SCAN_INTERVAL = 4       -- раз в N секунд сканировать мир на сундуки
local CHEST_MAX_DISTANCE = 200      -- проверять объекты только в радиусе (studs)

-- Вспомогательная функция: создание/обновление Highlight
local function createHighlight(object, fillColor, outlineColor)
    if not object then return end
    local existing = object:FindFirstChild("ESPHighlight")
    if existing and existing:IsA("Highlight") then
        existing.FillColor = fillColor
        existing.OutlineColor = outlineColor or Color3.fromRGB(255,255,255)
        return existing
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillColor = fillColor
    highlight.OutlineColor = outlineColor or Color3.fromRGB(255,255,255)
    highlight.FillTransparency = 0.35
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = object
    return highlight
end

-- Удаление всех подсветок (полезно при выключении)
local function clearAllHighlights()
    for plr, h in pairs(playerHighlights) do
        if h and h.Parent then pcall(function() h:Destroy() end) end
    end
    table.clear(playerHighlights)

    for obj, h in pairs(chestHighlights) do
        if h and h.Parent then pcall(function() h:Destroy() end) end
    end
    table.clear(chestHighlights)
end

-- Удаляет подсветку для конкретного объекта
local function removeChestHighlight(obj)
    local h = chestHighlights[obj]
    if h then
        pcall(function() h:Destroy() end)
        chestHighlights[obj] = nil
    end
end

-- PLAYER ESP: управление на событиях (не постоянный полный скан)
local function onCharacterAdded(player, character)
    if player == LocalPlayer then return end
    -- создаём Highlight, но только когда включено
    if espPlayersEnabled and character then
        local ok, h = pcall(function() return createHighlight(character, isTeammate and TEAM_COLOR or ENEMY_COLOR end)
        end)
        -- above is just placeholder; we'll set color below properly
    end
end

-- Функция, которая создаёт/обновляет подсветку игрока, вызывается при spawn и при смене состояния
local function ensurePlayerHighlight(player)
    if not player or player == LocalPlayer then return end
    local char = player.Character
    if not char or not char:IsDescendantOf(game) then
        -- cleanup if existed
        if playerHighlights[player] then
            pcall(function() playerHighlights[player]:Destroy() end)
            playerHighlights[player] = nil
        end
        return
    end

    -- Если уже есть подсветка — обновляем цвет
    if playerHighlights[player] and playerHighlights[player]:IsA("Highlight") then
        local color = isTeammate(player) and TEAM_COLOR or ENEMY_COLOR
        playerHighlights[player].FillColor = color
        playerHighlights[player].OutlineColor = Color3.fromRGB(255,255,255)
        return
    end

    -- Создаём и кэшируем
    local color = isTeammate(player) and TEAM_COLOR or ENEMY_COLOR
    local h = createHighlight(char, color, Color3.fromRGB(255,255,255))
    playerHighlights[player] = h
end

-- Подключаем обработчики для игроков
Players.PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(function(char)
        -- небольшой таймаут чтобы части персонажа успели создаться
        task.wait(0.1)
        if espPlayersEnabled then ensurePlayerHighlight(player) end
    end)
    player.CharacterRemoving:Connect(function()
        if playerHighlights[player] then
            pcall(function() playerHighlights[player]:Destroy() end)
            playerHighlights[player] = nil
        end
    end)
end)

-- Инициализируем для уже подключённых игроков
for _, p in pairs(Players:GetPlayers()) do
    if p.Character then
        p.CharacterAdded:Connect(function() if espPlayersEnabled then ensurePlayerHighlight(p) end end)
        p.CharacterRemoving:Connect(function() if playerHighlights[p] then pcall(function() playerHighlights[p]:Destroy() end); playerHighlights[p]=nil end end)
        if espPlayersEnabled then ensurePlayerHighlight(p) end
    else
        p.CharacterAdded:Connect(function() if espPlayersEnabled then ensurePlayerHighlight(p) end end)
    end
end

-- CHEST ESP: ограниченный скан, кэш и дистанция
local function isObjectClose(obj)
    if not LocalPlayer.Character then return false end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos
    if obj:IsA("BasePart") then
        pos = obj.Position
    elseif obj:IsA("Model") then
        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if primary then pos = primary.Position end
    end
    if not pos then return false end
    return (pos - hrp.Position).Magnitude <= CHEST_MAX_DISTANCE
end

local chestNamePatterns = { "chest", "box", "crate", "loot", "container" }

local function nameLooksLikeChest(name)
    if not name then return false end
    local lname = tostring(name):lower()
    for _, pat in ipairs(chestNamePatterns) do
        if lname:match(pat) then return true end
    end
    return false
end

local function scanForChests()
    -- Сначала подсвечиваем специально помеченные объекты
    local tagged = CollectionService:GetTagged("Interactable")
    for _, obj in ipairs(tagged) do
        if obj and obj.Parent and isInteractable(obj) and isObjectClose(obj) then
            if not chestHighlights[obj] then chestHighlights[obj] = createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255)) end
        else
            removeChestHighlight(obj)
        end
    end

    -- Затем ограниченный обход мира: только объекты с подходящими именами и в пределах дистанции
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameLooksLikeChest(obj.Name) then
            if isInteractable(obj) and isObjectClose(obj) then
                if not chestHighlights[obj] then chestHighlights[obj] = createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255)) end
            else
                removeChestHighlight(obj)
            end
        end
    end

    -- Удаляем подсветки для объектов, которых больше нет
    for obj, h in pairs(chestHighlights) do
        if not obj or not obj.Parent then
            pcall(function() h:Destroy() end)
            chestHighlights[obj] = nil
        end
    end
end

-- Фоновый цикл для скана сундуков с интервалом
task.spawn(function()
    while true do
        if espBoxesEnabled then
            pcall(scanForChests)
        else
            -- если выключено — чистим
            for obj, h in pairs(chestHighlights) do pcall(function() h:Destroy() end); chestHighlights[obj]=nil end
        end
        task.wait(CHEST_SCAN_INTERVAL)
    end
end)

-- ОБНОВЛЕНИЕ для игроков: обновляем цвета каждые N секунд, но основное делаем через события
task.spawn(function()
    while true do
        if espPlayersEnabled then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    ensurePlayerHighlight(player)
                end
            end
        else
            for p, h in pairs(playerHighlights) do pcall(function() h:Destroy() end); playerHighlights[p]=nil end
        end
        task.wait(2.5) -- редкий обновляющий цикл для цветов/новых игроков
    end
end)

-- Простая попытка авто-лута (будет пытаться активировать ProximityPrompt/ClickDetector через безопасные pcall вызовы)
local function attemptInteract(obj)
    if not obj then return false end
    for _, prompt in pairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                if prompt.Trigger then
                    prompt:Trigger(LocalPlayer)
                elseif prompt.Fire then
                    prompt:Fire(LocalPlayer)
                elseif prompt.InputHoldBegin then
                    prompt:InputHoldBegin()
                    task.wait(0.1)
                    prompt:InputHoldEnd()
                end
            end)
            return true
        end
        if prompt:IsA("ClickDetector") then
            pcall(function()
                if prompt.FireClick then
                    prompt:FireClick(LocalPlayer)
                end
            end)
            return true
        end
    end
    if obj:IsA("Tool") then
        return true
    end
    return false
end

-- Цикл авто-лута (включается по кнопке в GUI)
task.spawn(function()
    while true do
        if autoLootEnabled then
            -- проходим только по ближайшим объектам для экономии
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if (obj:IsA("Model") or obj:IsA("BasePart")) and nameLooksLikeChest(obj.Name) and isObjectClose(obj) and isInteractable(obj) then
                    pcall(function() attemptInteract(obj) end)
                end
            end
        end
        task.wait(1)
    end
end)

-- Анти-AFK — эмулируем лёгкие действия мыши/клавиш, чтобы игра не считала игрока AFK
local function startAntiAFK()
    if antiAFKEnabled then return end
    antiAFKEnabled = true
    task.spawn(function()
        while antiAFKEnabled do
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(0,0))
            end)
            task.wait(60 + math.random()*30)
        end
    end)
end

local function stopAntiAFK()
    antiAFKEnabled = false
end

