        local function updateUI(state)
            tiny.Text = state and "ON" or "OFF"
            local targetX = state and switchBack.Size.X.Offset - knob.Size.X.Offset - 4 or 2
            local tween = TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, targetX, 0, 2)})
            knob.BackgroundColor3 = state and Color3.fromRGB(200,30,30) or Color3.fromRGB(140,140,140)
            tween:Play()
        end
        updateUI(on)

        local activator = Instance.new("TextButton")
        activator.Size = UDim2.new(1,0,1,0)
        activator.BackgroundTransparency = 1
        activator.Text = ""
        activator.Parent = switchBack
        activator.MouseButton1Click:Connect(function()
            on = not on
            setVar(on)
            pcall(function() updateUI(on) end)
            if onToggle then onToggle(on) end
        end)
    end

    setupSwitch(pSwitch, pKnob, pTiny, function() return espPlayersEnabled end, function(v) espPlayersEnabled = v end)
    setupSwitch(bSwitch, bKnob, bTiny, function() return espBoxesEnabled end, function(v) espBoxesEnabled = v end)
    setupSwitch(aSwitch, aKnob, aTiny, function() return autoLootEnabled end, function(v) autoLootEnabled = v end)
    setupSwitch(fSwitch, fKnob, fTiny, function() return fastLootEnabled end, function(v) fastLootEnabled = v end)

    -- Dragging support for mainFrame
    do
        local dragging = false
        local dragInput, dragStart, startPos

        local function update(input)
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end

        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = mainFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        titleBar.InputChanged:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging and dragStart and startPos then
                update(input)
            end
        end)
    end

    -- Dragging for logo island
    do
        local dragging = false
        local dragStart, startPos
        local logoDragged = false

        logoAct.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
