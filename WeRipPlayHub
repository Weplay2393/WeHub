-- Настройки по умолчанию
local espPlayersEnabled = true
local espBoxesEnabled = true
local autoLootEnabled = false
local fastLootEnabled = false

-- Цвета
local TEAM_COLOR = Color3.fromRGB(0, 255, 0)    -- зеленый для тиммейтов
local ENEMY_COLOR = Color3.fromRGB(255, 0, 0)   -- красный для врагов
local CHEST_COLOR = Color3.fromRGB(0, 162, 255) -- синий для интерактивных сундуков

-- Кэш для оптимизации
local highlightCache = {}
local processedObjects = {}
local lastUpdateTime = 0
local UPDATE_INTERVAL = 0.5 -- обновление каждые 0.5 секунды вместо 2

-- Вспомогательная функция: создание/обновление Highlight
local function createHighlight(object, fillColor, outlineColor)
    if not object or not object.Parent then return end
    
    local objectId = object:GetFullName()
    local existing = object:FindFirstChild("ESPHighlight")
    
    if existing and existing:IsA("Highlight") then
        if highlightCache[objectId] then
            if highlightCache[objectId].fillColor ~= fillColor then
                existing.FillColor = fillColor
                highlightCache[objectId].fillColor = fillColor
            end
        end
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillColor = fillColor
    highlight.OutlineColor = outlineColor or Color3.fromRGB(255,255,255)
    highlight.FillTransparency = 0.35
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = object
    
    highlightCache[objectId] = {fillColor = fillColor}
end

-- Удаление всех подсветок
local function clearAllHighlights()
    for objectId, _ in pairs(highlightCache) do
        highlightCache[objectId] = nil
    end
    
    for _, h in pairs(Workspace:FindFirstChild("Highlights") and Workspace.Highlights:GetChildren() or {}) do
        if h:IsA("Highlight") then h:Destroy() end
    end
end

-- Определение: являются ли игроки тиммейтами
local function isTeammate(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false end

    if targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team == LocalPlayer.Team then return true end
    end

    local myRole = LocalPlayer:FindFirstChild("Role") or LocalPlayer:FindFirstChild("Status")
    local targetRole = targetPlayer:FindFirstChild("Role") or targetPlayer:FindFirstChild("Status")
    if myRole and targetRole and myRole.Value == targetRole.Value then
        return true
    end

    if LocalPlayer:GetAttribute("Role") and targetPlayer:GetAttribute("Role") then
        return LocalPlayer:GetAttribute("Role") == targetPlayer:GetAttribute("Role")
    end

    return false
end

-- Определение: можно ли взаимодействовать с объектом
local function isInteractable(obj)
    if not obj or not obj.Parent then return false end

    if obj:FindFirstChildOfClass("ProximityPrompt") then return true end
    if obj:FindFirstChildOfClass("ClickDetector") then return true end
    if obj:GetAttribute("CanInteract") == true then return true end
    if obj:FindFirstChild("Interaction") or obj:FindFirstChild("Interact") then return true end
    if CollectionService:HasTag(obj, "Interactable") then return true end

    return false
end

-- Обновление ESP игроков (оптимизированно)
local function updatePlayersESP()
    if not espPlayersEnabled then return end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local color = isTeammate(player) and TEAM_COLOR or ENEMY_COLOR
            createHighlight(player.Character, color, Color3.fromRGB(255,255,255))
        end
    end
end

-- Обновление ESP сундуков/коробок (оптимизированно)
local function updateChestsESP()
    if not espBoxesEnabled then return end

    local chestKeywords = {"chest", "box", "crate", "loot", "container"}
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
        if not obj.Parent then continue end
        
        local objectId = obj:GetFullName()
        if processedObjects[objectId] then continue end
        
        local name = tostring(obj.Name):lower()
        local isChest = false
        
        for _, keyword in ipairs(chestKeywords) do
            if name:match(keyword) then
                isChest = true
                break
            end
        end
        
        if isChest or CollectionService:HasTag(obj, "Interactable") then
            if isInteractable(obj) then
                createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255))
                processedObjects[objectId] = true
            end
        end
    end
end

-- АВТ ЛУТ: автоматическое собирание предметов
local function autoLoot()
    if not autoLootEnabled or not LocalPlayer.Character then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
        if not obj.Parent then continue end
        
        local name = tostring(obj.Name):lower()
        if name:match("loot") or name:match("item") or name:match("drop") or name:match("orb") then
            if obj:IsA("BasePart") then
                local distance = (obj.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
                if distance < 100 then
                    obj.CanCollide = false
                    obj.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + LocalPlayer.Character.HumanoidRootPart.CFrame.LookVector * 5
                end
            end
        end
    end
end

-- БЫСТРЫЙ ЛУТ: ускоренное взаимодействие с сундуками
local function fastLoot()
    if not fastLootEnabled then return end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if not (obj:IsA("Model") or obj:IsA("BasePart")) then continue end
        if not obj.Parent then continue end
        
        local name = tostring(obj.Name):lower()
        if name:match("chest") or name:match("box") or name:match("crate") then
            if isInteractable(obj) then
                local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
                if prompt then
                    prompt:InputHeld(LocalPlayer:GetMouse())
                end
                
                local detector = obj:FindFirstChildOfClass("ClickDetector")
                if detector then
                    detector:FireServer()
                end
            end
        end
    end
end

-- Основной фоновый цикл (оптимизированный)
task.spawn(function()
    while true do
        local currentTime = tick()
        if (currentTime - lastUpdateTime) >= UPDATE_INTERVAL then
            pcall(updatePlayersESP)
            pcall(updateChestsESP)
            pcall(autoLoot)
            pcall(fastLoot)
            lastUpdateTime = currentTime
        end
        task.wait(0.1)
    end
end)

