-- Вспомогательная функция: создание/обновление Highlight
local function createHighlight(object, fillColor, outlineColor)
    if not object then return end
    local existing = object:FindFirstChild("ESPHighlight")
    if existing and existing:IsA("Highlight") then
        existing.FillColor = fillColor
        existing.OutlineColor = outlineColor or Color3.fromRGB(255,255,255)
        return
    end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESPHighlight"
    highlight.FillColor = fillColor
    highlight.OutlineColor = outlineColor or Color3.fromRGB(255,255,255)
    highlight.FillTransparency = 0.35
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = object
end

-- Удаление всех подсветок (полезно при выключении)
local function clearAllHighlights()
    -- Обход игроков
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local h = plr.Character:FindFirstChild("ESPHighlight")
            if h and h:IsA("Highlight") then h:Destroy() end
        end
    end
    -- Обход мира
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local h = obj:FindFirstChild("ESPHighlight")
            if h and h:IsA("Highlight") then h:Destroy() end
        end
    end
end

-- Определение: являются ли игроки тиммейтами
local function isTeammate(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return false end

    -- 1) Стандартные Teams
    if targetPlayer.Team and LocalPlayer.Team then
        if targetPlayer.Team == LocalPlayer.Team then return true end
    end

    -- 2) Кастомные роли (Role / Status)
    local myRole = LocalPlayer:FindFirstChild("Role") or LocalPlayer:FindFirstChild("Status")
    local targetRole = targetPlayer:FindFirstChild("Role") or targetPlayer:FindFirstChild("Status")
    if myRole and targetRole and myRole.Value == targetRole.Value then
        return true
    end

    -- 3) Атрибуты
    if LocalPlayer:GetAttribute("Role") and targetPlayer:GetAttribute("Role") then
        return LocalPlayer:GetAttribute("Role") == targetPlayer:GetAttribute("Role")
    end

    return false
end

-- Определение: можно ли взаимодействовать с объектом ( сундук/коробка )
local function isInteractable(obj)
    if not obj then return false end

    -- 1) Если у объекта или у какой-то его части есть ProximityPrompt
    if obj:FindFirstChildOfClass("ProximityPrompt") then return true end
    -- Также проверяем потомков (части модели)
    for _, descendant in pairs(obj:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then return true end
        if descendant:IsA("ClickDetector") then return true end
    end

    -- 2) Наличие ClickDetector
    if obj:FindFirstChildOfClass("ClickDetector") then return true end

    -- 3) Атрибут CanInteract == true
    if obj:GetAttribute("CanInteract") == true then return true end

    -- 4) Наличие child с именем "Interaction" или "Interact"
    if obj:FindFirstChild("Interaction") or obj:FindFirstChild("Interact") then return true end

    -- 5) Тэг через CollectionService: "Interactable"
    if CollectionService:HasTag(obj, "Interactable") then return true end

    return false
end

-- Обновление ESP игроков
local function updatePlayersESP()
    if not espPlayersEnabled then
        -- при выключенном ESP игроков — удаляем их подсветки
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character then
                local h = plr.Character:FindFirstChild("ESPHighlight")
                if h and h:IsA("Highlight") then h:Destroy() end
            end
        end
        return
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local color = isTeammate(player) and TEAM_COLOR or ENEMY_COLOR
            createHighlight(player.Character, color, Color3.fromRGB(255,255,255))
        end
    end
end

-- Обновление ESP сундуков/коробок (только интерактивных)
local function updateChestsESP()
    if not espBoxesEnabled then
        -- удалить все подсветки сундуков
        for _, obj in pairs(Workspace:GetDescendants()) do
            if (obj:IsA("Model") or obj:IsA("BasePart")) and obj:FindFirstChild("ESPHighlight") then
                local h = obj:FindFirstChild("ESPHighlight")
                if h and h:IsA("Highlight") then h:Destroy() end
            end
        end
        return
    end

    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local name = tostring(obj.Name):lower()
            -- базовая проверка по имени, чтобы сужать поиск сундуков/коробок
            if name:match("chest") or name:match("box") or name:match("crate") or name:match("loot") or name:match("container") then
                if isInteractable(obj) then
                    createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255))
                else
                    -- если не интерактивный, убедимся, что подсветки нет
                    local h = obj:FindFirstChild("ESPHighlight")
                    if h and h:IsA("Highlight") then h:Destroy() end
                end
            else
                -- дополнительно: если объект помечен тэгом Interactable, тоже подсвечиваем
                if CollectionService:HasTag(obj, "Interactable") and isInteractable(obj) then
                    createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255))
                end
            end
        end
    end
end

-- Фоновый цикл обновления ESP
