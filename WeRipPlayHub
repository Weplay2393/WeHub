        label.Font = Enum.Font.Gotham
        label.TextSize = 12
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = parent

        local switchBack = Instance.new("Frame")
        switchBack.Size = UDim2.new(0, 56, 0, 30)
        switchBack.Position = UDim2.new(1, -76, 0, yOffset)
        switchBack.BackgroundColor3 = Color3.fromRGB(60,60,60)
        switchBack.Parent = parent
        local swCorner = Instance.new("UICorner", switchBack)
        swCorner.CornerRadius = UDim.new(0, 16)

