    local logoLabel = Instance.new("TextLabel")
    logoLabel.Name = "W"
    logoLabel.Size = UDim2.new(1,0,1,0)
    logoLabel.BackgroundTransparency = 1
    logoLabel.Text = "W"
    logoLabel.TextColor3 = Color3.fromRGB(220,20,20)
    logoLabel.Font = Enum.Font.GothamBlack
    logoLabel.TextSize = 26
    logoLabel.Parent = logoIsland

    -- Title text
    local title = Instance.new("TextLabel")
    title.Name = "Title"
    title.Size = UDim2.new(1, -80, 0, 40)
    title.Position = UDim2.new(0, 64, 0, 4)
    title.BackgroundTransparency = 1
    title.Text = "WeHub — ESP"
    title.TextColor3 = Color3.fromRGB(255,220,220)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Parent = titleBar

    -- Minimize button
    local btnMin = Instance.new("ImageButton")
    btnMin.Name = "Min"
    btnMin.Size = UDim2.new(0, 32, 0, 32)
    btnMin.Position = UDim2.new(1, -44, 0, 8)
    btnMin.BackgroundTransparency = 1
    btnMin.Image = "rbxassetid://6023426915" -- simple icon
    btnMin.Parent = titleBar

    -- Content area
    local content = Instance.new("Frame")
    content.Name = "Content"
    content.Size = UDim2.new(1, -24, 1, -86)
    content.Position = UDim2.new(0, 12, 0, 60)
    content.BackgroundTransparency = 1
    content.Parent = mainFrame

    -- Helper: create slider (switch) UI
    local function makeSliderRow(parent, yOffset, labelText, initial)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(0.68, 0, 0, 32)
        label.Position = UDim2.new(0, 8, 0, yOffset)
        label.Text = labelText
        label.TextColor3 = Color3.fromRGB(230,230,230)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.Gotham
        label.TextSize = 14
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = parent

        local switchBack = Instance.new("Frame")
        switchBack.Size = UDim2.new(0, 56, 0, 30)
        switchBack.Position = UDim2.new(1, -76, 0, yOffset)
        switchBack.BackgroundColor3 = Color3.fromRGB(60,60,60)
        switchBack.Parent = parent
        local swCorner = Instance.new("UICorner", switchBack)
        swCorner.CornerRadius = UDim.new(0, 16)

        local knob = Instance.new("Frame")
        knob.Name = "Knob"
        knob.Size = UDim2.new(0, 26, 0, 26)
        knob.Position = UDim2.new(0, 2, 0, 2)
        knob.BackgroundColor3 = initial and Color3.fromRGB(200,30,30) or Color3.fromRGB(140,140,140)
        knob.Parent = switchBack
        local kCorner = Instance.new("UICorner", knob)
        kCorner.CornerRadius = UDim.new(0, 14)

        -- Label for ON/OFF inside switch (small)
        local tiny = Instance.new("TextLabel")
        tiny.Size = UDim2.new(1, -4, 1, 0)
        tiny.Position = UDim2.new(0, 2, 0, 0)
        tiny.BackgroundTransparency = 1
        tiny.Text = initial and "ON" or "OFF"
        tiny.TextColor3 = Color3.fromRGB(255,255,255)
        tiny.Font = Enum.Font.Gotham
        tiny.TextSize = 12
        tiny.Parent = switchBack

        return switchBack, knob, tiny
    end

    -- Create sliders
    local y = 0
    local pSwitch, pKnob, pTiny = makeSliderRow(content, y, "ESP Players (Green = Team, Red = Enemy)", espPlayersEnabled)
    y = y + 44
    local bSwitch, bKnob, bTiny = makeSliderRow(content, y, "ESP Chests (Blue - Interactables)", espBoxesEnabled)

    -- Minimize behaviour: теперь скрываем только контент и меняем размер окна
    local isMin = false
    local function setMinimized(state)
        isMin = state
        if isMin then
            content.Visible = false
            mainFrame.Size = minimizedMainSize
        else
            content.Visible = true
            mainFrame.Size = originalMainSize
        end
    end

    btnMin.MouseButton1Click:Connect(function()
        setMinimized(not isMin)
    end)

    -- Logo island click toggles menu visibility (теперь тоже минифицирует/разворачивает, а не убирает весь ScreenGui)
    local function toggleMenuVisible()
        setMinimized(not isMin)
        if not isMin then
            -- восстановление: ничего дополнительно делать
        else
            -- при сворачивании мы не чистим подсветки автоматически - это поведение оставлено
        end
    end

    -- Создаем overlay-кнопку для логотипа (она нужна чтобы ловить клики/тачи)
    local logoAct = Instance.new("TextButton")
    logoAct.Size = UDim2.new(1,0,1,0)
    logoAct.BackgroundTransparency = 1
    logoAct.Text = ""
    logoAct.Parent = logoIsland

    -- Toggle handlers with smooth tween (knob slide)
    local function setupSwitch(switchBack, knob, tiny, getVar, setVar)
        local on = getVar()
        local function updateUI(state)
            tiny.Text = state and "ON" or "OFF"
            local targetX = state and switchBack.Size.X.Offset - knob.Size.X.Offset - 4 or 2
            local tween = TweenService:Create(knob, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, targetX, 0, 2)})
            knob.BackgroundColor3 = state and Color3.fromRGB(200,30,30) or Color3.fromRGB(140,140,140)
            tween:Play()
        end
        -- initialize position
        updateUI(on)

        local activator = Instance.new("TextButton")
        activator.Size = UDim2.new(1,0,1,0)
        activator.BackgroundTransparency = 1
        activator.Text = ""
        activator.Parent = switchBack
        activator.MouseButton1Click:Connect(function()
            on = not on
            setVar(on)
            pcall(function() updateUI(on) end)
            if switchBack == pSwitch then
                espPlayersEnabled = on
                if not on then clearAllHighlights() end
            elseif switchBack == bSwitch then
                espBoxesEnabled = on
                if not on then clearAllHighlights() end
            end
        end)
    end

    setupSwitch(pSwitch, pKnob, pTiny, function() return espPlayersEnabled end, function(v) espPlayersEnabled = v end)
    setupSwitch(bSwitch, bKnob, bTiny, function() return espBoxesEnabled end, function(v) espBoxesEnabled = v end)

    -- Dragging support for mainFrame (через TitleBar, надёжнее)
    do
        local dragging = false
        local dragInput, dragStart, startPos

        local function update(input)
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end

        titleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = mainFrame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        titleBar.InputChanged:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging and dragStart and startPos then
                update(input)
            end
        end)
    end

    -- Dragging for logo island (реализовано через logoAct, клик игнорируется если был drag)
    do
        local dragging = false
        local dragStart, startPos
        local logoDragged = false

        logoAct.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = logoIsland.Position
                logoDragged = false
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        logoAct.InputChanged:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging and dragStart and startPos then
                local delta = input.Position - dragStart
                -- порог чтобы отличать клик от драгa
                if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
                    logoDragged = true
                end
                logoIsland.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)

        logoAct.MouseButton1Click:Connect(function()
            if logoDragged then
                -- если был drag — игнорируем клик (и сбрасываем флаг)
                logoDragged = false
                return
            end
            toggleMenuVisible()
        end)
    end

end

