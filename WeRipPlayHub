    content.Size = UDim2.new(1, -20, 1, -56)
    content.Position = UDim2.new(0, 10, 0, 44)
    content.BackgroundTransparency = 1
    content.Parent = mainFrame

    -- Rows
    local y = 0
    local function addRow(labelText, initialState)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.7, 0, 0, 28)
        lbl.Position = UDim2.new(0, 8, 0, y)
        lbl.Text = labelText
        lbl.BackgroundTransparency = 1
        lbl.TextColor3 = Color3.fromRGB(230,230,230)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 14
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = content

        local sw, setState = makeSwitch(content, UDim2.new(1, -88, 0, y), initialState)
        y = y + 36
        return sw, setState
    end

    local swPlayers, setPlayers = addRow("ESP Players (green = team, red = enemy)", espPlayersEnabled)
    local swChests, setChests = addRow("ESP Chests (blue - interactables)", espBoxesEnabled)
    local swLoot, setLoot = addRow("Auto Loot (attempt)", autoLootEnabled)
    local swAFK, setAFK = addRow("Anti-AFK (simple)", antiAFKEnabled)

    -- Footer
    local footer = Instance.new("TextLabel")
    footer.Size = UDim2.new(1, -16, 0, 18)
    footer.Position = UDim2.new(0, 8, 1, -26)
    footer.BackgroundTransparency = 1
    footer.Text = "Optimized scans: players via events, chests limited by distance and interval."
    footer.TextColor3 = Color3.fromRGB(180,180,180)
    footer.Font = Enum.Font.Gotham
    footer.TextSize = 11
    footer.TextXAlignment = Enum.TextXAlignment.Left
    footer.Parent = mainFrame

    -- Handlers
    btnClose.MouseButton1Click:Connect(function()
        screenGui:Destroy()
        local f = PlayerGui:FindFirstChild("WeHubFloat")
        if f then f:Destroy() end
        clearAllHighlights()
    end)

    -- Sync state when switch attribute changes
    local function bindSwitch(sw, onChange)
        sw:GetPropertyChangedSignal("AbsolutePosition"):Connect(function() end) -- noop to keep connection alive
        sw:GetAttributeChangedSignal = sw.GetAttributeChangedSignal or function() end -- safe
        -- Poll attribute change (simple, cheap)
        task.spawn(function()
            local last = sw:GetAttribute("State")
            while sw and sw.Parent do
                local cur = sw:GetAttribute("State")
                if cur ~= last then
                    last = cur
                    onChange(cur)
                end
                task.wait(0.12)
            end
        end)
    end

    bindSwitch(swPlayers, function(state)
        espPlayersEnabled = state
        if not state then
            for p, h in pairs(playerHighlights) do pcall(function() h:Destroy() end); playerHighlights[p]=nil end
        else
            for _, p in pairs(Players:GetPlayers()) do if p~=LocalPlayer then ensurePlayerHighlight(p) end end
        end
    end)

    bindSwitch(swChests, function(state)
        espBoxesEnabled = state
        if not state then for obj,h in pairs(chestHighlights) do pcall(function() h:Destroy() end); chestHighlights[obj]=nil end end
    end)

    bindSwitch(swLoot, function(state)
        autoLootEnabled = state
    end)

    bindSwitch(swAFK, function(state)
        antiAFKEnabled = state
        if state then startAntiAFK() else stopAntiAFK() end
    end)

    -- Make menu draggable for touch and mouse
    local dragging = false
    local dragStart, startPos
    local function onInputBegan(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end
    local function onInputChanged(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) and dragging and dragStart and startPos then
            local delta = input.Position - dragStart
            mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end
    titleBar.InputBegan:Connect(onInputBegan)
    titleBar.InputChanged:Connect(onInputChanged)
    mainFrame.InputBegan:Connect(onInputBegan)
    mainFrame.InputChanged:Connect(onInputChanged)

    -- Ensure initial states are in sync
    swPlayers:SetAttribute("State", espPlayersEnabled)
    swChests:SetAttribute("State", espBoxesEnabled)
    swLoot:SetAttribute("State", autoLootEnabled)
    swAFK:SetAttribute("State", antiAFKEnabled)

end

