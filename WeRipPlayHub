end)

-- Простая попытка авто-лута (будет пытаться активировать ProximityPrompt/ClickDetector через безопасные pcall вызовы)
local function attemptInteract(obj)
    if not obj then return false end
    -- Ищем ProximityPrompt
    for _, prompt in pairs(obj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                -- несколько возможных вариантов методов, на случай разных реализаций
                if prompt.Trigger then
                    prompt:Trigger(LocalPlayer)
                elseif prompt.Fire then
                    prompt:Fire(LocalPlayer)
                elseif prompt.InputHoldBegin then
                    prompt:InputHoldBegin()
                    task.wait(0.1)
                    prompt:InputHoldEnd()
                end
            end)
            return true
        end
        if prompt:IsA("ClickDetector") then
            pcall(function()
                if prompt.FireClick then
                    prompt:FireClick(LocalPlayer)
                end
            end)
            return true
        end
    end

    -- Если у самого obj есть методы/атрибуты
    if obj:IsA("Tool") then
        pcall(function()
            if obj.Parent and obj.Parent:IsA("Backpack") then
                -- попытка взять в инвентарь — noop на клиенте
            end
        end)
        return true
    end

    return false
end

-- Цикл авто-лута (включается по кнопке в GUI)
task.spawn(function()
    while true do
        if autoLootEnabled then
            for _, obj in pairs(Workspace:GetDescendants()) do
                local ok = false
                if isInteractable(obj) then
                    pcall(function()
                        ok = attemptInteract(obj)
                        -- Если объект модель — пытаться взаимодействовать с его PrimaryPart
                        if not ok and obj:IsA("Model") then
                            local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if primary and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                                local saved = LocalPlayer.Character.HumanoidRootPart.CFrame
                                LocalPlayer.Character.HumanoidRootPart.CFrame = primary.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.2)
                                attemptInteract(obj)
                                task.wait(0.1)
                                LocalPlayer.Character.HumanoidRootPart.CFrame = saved
                            end
                        end
                    end)
                end
            end
        end
        task.wait(0.8)
    end
end)

-- Анти-AFK — эмулируем лёгкие действия мыши/клавиш, чтобы игра не считала игрока AFK
-- Я могу помочь с анти-AFK (простая реализация ниже). Я НЕ буду помогать с обходом бана/кика от разработчиков (см. сообщение при коммите).
local function startAntiAFK()
    if antiAFKEnabled then return end
    antiAFKEnabled = true
    task.spawn(function()
        while antiAFKEnabled do
            pcall(function()
                -- захват контроллера виртуальным юзером и клик
                VirtualUser:CaptureController()
                VirtualUser:ClickButton1(Vector2.new(0,0))
            end)
            task.wait(60 + math.random()*30)
        end
    end)
end

local function stopAntiAFK()
    antiAFKEnabled = false
end

