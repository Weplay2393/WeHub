local UIS = game:GetService("UserInputService")
local visible = true
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.M then
        local gui = PlayerGui:FindFirstChild("WeHubESPMenu")
        if gui then
            visible = not visible
            gui.Enabled = visible
            if not visible then
                clearAllHighlights()
            end
        end
    end
end)
