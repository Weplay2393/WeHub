-- CHEST ESP: ограниченный скан, кэш и дистанция
local function isObjectClose(obj)
    if not LocalPlayer.Character then return false end
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local pos
    if obj:IsA("BasePart") then
        pos = obj.Position
    elseif obj:IsA("Model") then
        local primary = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
        if primary then pos = primary.Position end
    end
    if not pos then return false end
    return (pos - hrp.Position).Magnitude <= CHEST_MAX_DISTANCE
end

local chestNamePatterns = { "chest", "box", "crate", "loot", "container" }
local function nameLooksLikeChest(name)
    if not name then return false end
    local lname = tostring(name):lower()
    for _, pat in ipairs(chestNamePatterns) do
        if lname:match(pat) then return true end
    end
    return false
end

local function scanForChests()
    local tagged = CollectionService:GetTagged("Interactable")
    for _, obj in ipairs(tagged) do
        if obj and obj.Parent and isInteractable(obj) and isObjectClose(obj) then
            if not chestHighlights[obj] then chestHighlights[obj] = createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255)) end
        else
            removeChestHighlight(obj)
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and nameLooksLikeChest(obj.Name) then
            if isInteractable(obj) and isObjectClose(obj) then
                if not chestHighlights[obj] then chestHighlights[obj] = createHighlight(obj, CHEST_COLOR, Color3.fromRGB(255,255,255)) end
            else
                removeChestHighlight(obj)
            end
        end
    end

    for obj, h in pairs(chestHighlights) do
        if not obj or not obj.Parent then
            pcall(function() h:Destroy() end)
            chestHighlights[obj] = nil
        end
    end
end

-- Фоновый цикл для скана сундуков с интервалом
