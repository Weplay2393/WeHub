    titleBar.Parent = mainFrame

    -- Logo island (перемещаемая красная W на чёрном фоне)
    local logoIsland = Instance.new("Frame")
    logoIsland.Name = "LogoIsland"
    logoIsland.Size = UDim2.new(0, 44, 0, 44)
    logoIsland.Position = UDim2.new(0, 8, 0, 6)
    logoIsland.BackgroundColor3 = Color3.fromRGB(0,0,0)
    logoIsland.BorderSizePixel = 0
    logoIsland.Parent = mainFrame
    local logoCorner = Instance.new("UICorner", logoIsland)
