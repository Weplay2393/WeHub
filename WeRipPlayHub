                mf.Visible = not mf.Visible
                if not mf.Visible then
                    clearAllHighlights()
                end
            end
        else
            -- если меню удалено, создаём заново
            createMenu()
        end
    end)

end

-- Создаем меню при старте
createMenu()

-- Быстрое скрытие/показ клавишей M
local visible = true
UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.M then
        local gui = PlayerGui:FindFirstChild("WeHubESPMenu")
        if gui then
            visible = not visible
            gui.Enabled = visible
            if not visible then
                clearAllHighlights()
            end
        end
    end
end)
