-- Helper: создаёт переключатель-ползунок, возвращает switchFrame и функцию установки состояния
local function makeSwitch(parent, position, initialState)
    local sw = Instance.new("Frame")
    sw.Size = UDim2.new(0, 52, 0, 26)
    sw.Position = position
    sw.BackgroundColor3 = initialState and Color3.fromRGB(0,150,0) or Color3.fromRGB(80,80,80)
    sw.Parent = parent
    sw.Active = true
    sw.Name = "Switch"
    Instance.new("UICorner", sw).CornerRadius = UDim.new(0, 12)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.new(0, 22, 0, 22)
    knob.Position = initialState and UDim2.new(1, -24, 0, 2) or UDim2.new(0, 2, 0, 2)
    knob.BackgroundColor3 = Color3.fromRGB(245,245,245)
    knob.Parent = sw
    Instance.new("UICorner", knob).CornerRadius = UDim.new(0, 12)

    local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function setState(state)
        sw.BackgroundColor3 = state and Color3.fromRGB(0,150,0) or Color3.fromRGB(80,80,80)
        local targetPos = state and UDim2.new(1, -24, 0, 2) or UDim2.new(0, 2, 0, 2)
        TweenService:Create(knob, tweenInfo, {Position = targetPos}):Play()
    end

    -- Interaction
    sw.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            initialState = not initialState
            setState(initialState)
            -- emit custom event via property
            sw:SetAttribute("State", initialState)
        end
    end)

    -- set initial
    sw:SetAttribute("State", initialState)

    return sw, setState
end

